<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Btd700Ctl.Gui.AboutWindow"
    Width="350"
    Height="200"
    Title="About"
    CanResize="False">



    <Grid RowDefinitions="*,Auto">
        <StackPanel 
            Grid.Row="0"
            Margin="24"
            Spacing="12">

            <TextBlock Text="BTD700Ctl Gui" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Based on btd700ctl by www.github.com/sobalap" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="Avalonia UI is kinda awesome" FontSize="12" HorizontalAlignment="Center"/>

        </StackPanel>
        <Button Grid.Row="1" Content="GitHub" HorizontalAlignment="Center" Margin="24" Padding="16,8" Command="{Binding ShowGithubCommand}"/>
    </Grid>

</Window>