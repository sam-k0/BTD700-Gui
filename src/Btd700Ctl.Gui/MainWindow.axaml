<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Btd700Ctl.Gui.ViewModels"
        xmlns:sys="using:System"
        x:Class="Btd700Ctl.Gui.MainWindow"
        Title="BTD700 Control GUI"
        Width="900"
        Height="760"
        CanResize="False">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Styles>
        <Style Selector="Button.active">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style Selector="Button.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="20">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  VerticalAlignment="Center">
                <StackPanel Grid.Column="0"
                            Spacing="4"
                            VerticalAlignment="Center">

                    <TextBlock Text="BTD700 Control"
                               FontSize="28"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="0,0,12,0"
                        Padding="14,8"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="{Binding ConnectionBrush}"
                                 VerticalAlignment="Center" />

                        <TextBlock Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   FontSize="13" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <Button Content="{Binding ToggleConnectionButtonText}"
                            Command="{Binding ToggleConnectionCommand}"
                            Padding="18,9" />

                </StackPanel>
            </Grid>


            <!-- Audio -->

            <Border CornerRadius="12"
                    Padding="20"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Spacing="16">

                    <!-- Header -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="Audio"
                                   FontSize="19"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Configure how audio is transmitted to your headphones."
                                   FontSize="12"
                                   Opacity="0.55" />
                    </StackPanel>


                    <!-- Mode selector -->
                    <Grid ColumnDefinitions="*,*,*">

                        <Button Grid.Column="0"
                                Margin="0,0,3,0"
                                Content="Standard"
                                Command="{Binding SelectAudioModeCommand}"
                                CommandParameter="HighQuality"
                                HorizontalContentAlignment="Center"
                                Padding="12,9"
                                Classes.active="{Binding IsStandardMode}" />

                        <Button Grid.Column="1"
                                Margin="3,0"
                                Content="Gaming"
                                Command="{Binding SelectAudioModeCommand}"
                                CommandParameter="Gaming"
                                HorizontalContentAlignment="Center"
                                Padding="12,9"
                                Classes.active="{Binding IsGamingMode}" />

                        <!-- <Button Grid.Column="2"
                                Margin="3,0,0,0"
                                Content="Broadcast"
                                Command="{Binding SelectAudioModeCommand}"
                                CommandParameter="Broadcast"
                                HorizontalContentAlignment="Center"
                                Padding="12,9"
                                Classes.active="{Binding IsBroadcastMode}" /> -->

                    </Grid>


                    <!-- ========================================================= -->
                    <!-- Standard Mode                                             -->
                    <!-- ========================================================= -->

                    <Border IsVisible="{Binding IsStandardMode}"
                            Padding="4">

                        <Grid ColumnDefinitions="150,*"
                              RowDefinitions="Auto,Auto">

                            <TextBlock Text="Transport"
                                       VerticalAlignment="Center"
                                       Opacity="0.75" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TransportModeNames}"
                                      SelectedItem="{Binding SelectedTransportMode}"
                                      MinWidth="240" />

                            <TextBlock Grid.Row="1"
                                       Text="Codec"
                                       VerticalAlignment="Center"
                                       Opacity="0.75" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding CodecNames}"
                                      SelectedItem="{Binding SelectedCodec}"
                                      MinWidth="240" />

                        </Grid>

                    </Border>


                    <!-- ========================================================= -->
                    <!-- Gaming Mode                                               -->
                    <!-- ========================================================= -->

                    <Border IsVisible="{Binding IsGamingMode}"
                            Padding="4" />


                    <!-- ========================================================= -->
                    <!-- Broadcast Mode                                            -->
                    <!-- ========================================================= -->

                    <Border IsVisible="{Binding IsBroadcastMode}"
                            Padding="4">

                        <Grid ColumnDefinitions="150,*"
                              RowDefinitions="Auto,Auto,Auto">

                            <TextBlock Text="Broadcast name"
                                       VerticalAlignment="Center"
                                       Opacity="0.75" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding BroadcastName}"
                                     MinWidth="240" />

                            <TextBlock Grid.Row="1"
                                       Text="Quality"
                                       VerticalAlignment="Center"
                                       Opacity="0.75" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding BroadcastQualityNames}"
                                      SelectedItem="{Binding SelectedQuality}"
                                      MinWidth="240" />

                            <TextBlock Grid.Row="2"
                                       Text="Encryption"
                                       VerticalAlignment="Center"
                                       Opacity="0.75" />

                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding EncryptionModeNames}"
                                      SelectedItem="{Binding SelectedEncryption}"
                                      MinWidth="240" />

                        </Grid>

                    </Border>


                    <!-- Active codec -->
                    <Border IsVisible="{Binding IsNotBroadcastMode}"
                            Padding="4">

                        <Grid ColumnDefinitions="150,*">

                            <TextBlock Text="Active Codec"
                                       VerticalAlignment="Center"
                                       Opacity="0.75" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveCodec}"
                                       FontSize="12"
                                       Opacity="0.75" />

                        </Grid>

                    </Border>


                    <!-- Broadcast controls -->
                    <StackPanel IsVisible="{Binding IsBroadcastMode}"
                                Orientation="Horizontal"
                                Spacing="8">

                        <Button Content="Start"
                                Command="{Binding StartBroadcastCommand}"
                                Padding="18,9" />

                        <Button Content="Pause"
                                Command="{Binding PauseBroadcastCommand}"
                                Padding="18,9" />

                        <Button Content="Stop"
                                Command="{Binding StopBroadcastCommand}"
                                Padding="18,9" />

                    </StackPanel>



                </StackPanel>
            </Border>



            <Grid ColumnDefinitions="*,*">

                <!-- Device information -->
                <Border Grid.Column="0"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,10,0"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                    <Grid RowDefinitions="Auto,*">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Device information"
                                       FontSize="19"
                                       FontWeight="SemiBold" />

                            <Button Grid.Column="1"
                                    Padding="18,9"
                                    Content="{Binding DeviceInfoToggleText}"
                                    Command="{Binding ToggleDeviceInfoPopupCommand}" />
                        </Grid>

                        <Border Grid.Row="1"
                                IsVisible="{Binding IsDeviceInfoPopupOpen}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,12,0,0"
                                Background="{DynamicResource SystemControlBackgroundLowBrush}">

                            <Grid ColumnDefinitions="150,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto">

                                <TextBlock Text="Manufacturer"
                                           Opacity="0.55"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Manufacturer}"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1"
                                           Text="Product"
                                           Opacity="0.55"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Product}"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2"
                                           Text="Serial"
                                           Opacity="0.55"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding Serial}"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3"
                                           Text="Firmware"
                                           Opacity="0.55" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding FirmwareVersion}" />

                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- Event log -->
                <Border Grid.Column="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="10,0,0,0"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Event log"
                                           FontSize="19"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Recent device activity"
                                           FontSize="12"
                                           Opacity="0.55" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Padding="18,9"
                                    Content="{Binding EventLogToggleText}"
                                    Command="{Binding ToggleEventLogCommand}" />
                        </Grid>

                        <Border IsVisible="{Binding IsEventLogOpen}"
                                CornerRadius="8"
                                Padding="10"
                                Background="{DynamicResource SystemControlBackgroundLowBrush}">

                            <ListBox ItemsSource="{Binding Events}"
                                     Height="150"
                                     Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                     BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                     Padding="4">

                                <ListBox.DataTemplates>

                                    <DataTemplate x:DataType="sys:String">
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Margin="6,4" />
                                    </DataTemplate>

                                </ListBox.DataTemplates>

                            </ListBox>

                        </Border>

                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
